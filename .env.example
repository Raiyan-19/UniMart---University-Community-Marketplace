# =================================================================
# UniMart Production & Database Environment Variables
# =================================================================

# APP_URL: Public URL where your app is hosted
APP_URL="http://localhost:3000"

# --- PostgreSQL + Prisma (Supabase Free Tier) ---
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> Database -> Connection string -> URI -> Select "Session pooler" (port 5432, IPv4 compatible)
#    Paste that single URI below:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Stateless JWT Auth ---
# Generate a strong random secret (32+ chars), e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-strong-32-plus-character-random-secret"

# --- Cloud Image Uploads (Supabase Storage Free 1GB) ---
# 1. In Supabase Dashboard -> Storage -> Create public bucket named: unimart-uploads
# 2. Project Settings -> API -> copy Project URL & service_role key
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET="unimart-uploads"

# GEMINI_API_KEY: Optional for AI features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# =================================================================
# UniMart Email Delivery Configuration
# Choose ONE of the options below to deliver real emails to user inboxes:
# =================================================================

# --- OPTION 1: Resend (Recommended - 3,000 Free Emails/Month) ---
# RESEND_API_KEY="re_1234567890abcdef"
# RESEND_FROM="UniMart <onboarding@resend.dev>"

# --- OPTION 2: Gmail SMTP (Use 16-char Google App Password) ---
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# EMAIL_FROM="UniMart Support <your-email@gmail.com>"

# --- OPTION 3: Brevo ---
# BREVO_API_KEY="xkeysib-..."
# BREVO_FROM="UniMart Support <no-reply@unimart.edu>"
